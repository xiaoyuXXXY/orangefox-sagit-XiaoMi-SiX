+bool GUIScrollList::ItemsFitWindow()
+{
+	if (GetItemCount() == 0)
+		return true;
+	return (int)GetItemCount() * actualItemHeight <= (mRenderH - mHeaderH);
+}
+
+bool GUIScrollList::SkipGroupPadding()
+{
+	if (!isGroup || GetItemCount() == 0)
+		return false;
+	int winH = mRenderH - mHeaderH;
+	int itemsH = (int)GetItemCount() * actualItemHeight;
+	// Only drop the padding when it is what makes the content overflow
+	return itemsH <= winH && itemsH + mItemPaddingTop > winH;
+}
