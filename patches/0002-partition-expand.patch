+// OrangeFox: 把某个块设备上的所有挂载点全部卸掉。
+// TWPartition::UnMount() 只处理分区本身的挂载点，而 /sdcard、/storage 这类
+// bind mount 的 source 也是同一个设备，会一直挂着。此时 mke2fs 即使带 -F
+// 也会直接拒绝："is mounted; will not make a filesystem here!"。
+// 返回仍然挂着的挂载点数量（0 表示已卸干净）。
+static int Fox_Force_Unmount_Device(const std::string& dev) {
+	if (dev.empty())
+		return 0;
+	int remaining = 0;
+	for (int round = 0; round < 6; ++round) {
+		std::vector<std::string> mps;
+		FILE* fp = fopen("/proc/mounts", "rt");
+		if (!fp)
+			break;
+		char line[4096];
+		while (fgets(line, sizeof(line), fp)) {
+			char src[512] = {0};
+			char mp[512] = {0};
+			if (sscanf(line, "%511s %511s", src, mp) == 2 && dev == src && mp[0] == '/')
+				mps.push_back(mp);
+		}
+		fclose(fp);
+		if (mps.empty())
+			return 0;
+		remaining = (int)mps.size();
+		for (size_t i = 0; i < mps.size(); ++i) {
+			LOGINFO("OrangeFox: force-unmount '%s' (device %s)\n", mps[i].c_str(), dev.c_str());
+			if (umount2(mps[i].c_str(), 0) != 0)
+				umount2(mps[i].c_str(), MNT_DETACH);
+		}
+		usleep(200000);
+	}
+	return remaining;
+}
