+void TWPartition::Remove_Legacy_Media_Symlink(void) {
+	// v21 created a "/data/Media -> media" symlink while chasing a message
+	// that turned out to be a bad translation rather than a missing path.
+	// Clean up that leftover, but only if it is exactly the link we made.
+	string Legacy_Path = Mount_Point + "/Media";
+	struct stat st;
+
+	if (!Mount(false)) {
+		LOGINFO("Skipping legacy media symlink cleanup, %s is not mounted\n", Mount_Point.c_str());
+		return;
+	}
+	if (lstat(Legacy_Path.c_str(), &st) != 0 || !S_ISLNK(st.st_mode))
+		return;
+
+	char target[256] = {0};
+	ssize_t len = readlink(Legacy_Path.c_str(), target, sizeof(target) - 1);
+	if (len <= 0 || string(target) != "media")
+		return;
+
+	if (unlink(Legacy_Path.c_str()) == 0)
+		LOGINFO("Removed leftover compatibility symlink '%s'\n", Legacy_Path.c_str());
+	else
+		LOGERR("Could not remove leftover symlink '%s' (%s)\n", Legacy_Path.c_str(), strerror(errno));
 }
 
