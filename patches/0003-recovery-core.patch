+
+			if (ev.code == KEY_VOLUMEUP) {
+				combo = kb->IsKeyDown(KEY_POWER) && power_down_ms > 0 &&
+						(now_ms - power_down_ms) <= 400;
+				volup_down_ms = now_ms;
+			} else {
+				combo = kb->IsKeyDown(KEY_VOLUMEUP) && volup_down_ms > 0 &&
+						(now_ms - volup_down_ms) <= 400;
+				power_down_ms = now_ms;
+			}
+
+			if (combo && DataManager::GetStrValue("of_flashlight_enable") == "1") {
+				LOGEVENT("FOX: flashlight combo (single tap)\n");
+				GUIAction::flashlightImpl("");
+				DataManager::Vibrate("tw_button_vibrate");
+				// Do not let the power key turn the screen off on release
+				g_suppress_power_toggle_until_ms = now_ms + 800;
+				// Block the press-and-hold handler from firing this combo twice
+				key_status = KS_KEY_REPEAT;
+				mime = 0;
+				touch_status = TS_NONE;
+				return;
+			}
+		}
 #ifdef TW_USE_KEY_CODE_TOUCH_SYNC
 		if (ev.code == TW_USE_KEY_CODE_TOUCH_SYNC) {
