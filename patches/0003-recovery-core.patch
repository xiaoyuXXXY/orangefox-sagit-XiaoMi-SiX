+  // A bare "boot-recovery" BCB is what our own reboot-to-recovery path leaves in
+  // /misc (see TWFunc::tw_reboot). Consume it right away: the bootloader has
+  // already done its part, and keeping it around would send the next reboot back
+  // into recovery. BCBs carrying arguments (OTA "--update_package=...") are left
+  // untouched for the normal recovery flow. TWRP's fstab is not an fs_mgr one, so
+  // resolve /misc by hand and fall back to the by-name node.
+  {
+    std::string bcb_err;
+    std::string misc_dev = get_bootloader_message_blk_device(&bcb_err);
+    if (misc_dev.empty()) {
+      misc_dev = "/dev/block/bootdevice/by-name/misc";
+    }
+    bootloader_message boot = {};
+    if (read_bootloader_message_from(&boot, misc_dev, &bcb_err) &&
+        strncmp(boot.command, "boot-recovery", sizeof(boot.command)) == 0 &&
+        boot.recovery[0] == '\0') {
+      if (write_bootloader_message_to(bootloader_message{}, misc_dev, &bcb_err)) {
+        LOG(INFO) << "Cleared bare boot-recovery BCB left by reboot-to-recovery";
+      } else {
+        LOG(ERROR) << "Failed to clear BCB: " << bcb_err;
+      }
+    }
+  }
+
